---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Stars from '../components/Stars.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import PostCard from '../components/PostCard.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../site.config.mjs';
import {
  getAllArticles, relatedArticles, categoryFor, categoryUrl, articleUrl, absoluteUrl,
  formatDate, readingTime, productAnchor, shortName, affiliateUrl, plain, type Article,
} from '../lib/articles';
import { md, mdInline } from '../lib/md';

export async function getStaticPaths() {
  const all = await getAllArticles();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Article };
const { Content } = await render(entry);
const d = entry.data;
const slug = entry.id;
const path = articleUrl(slug);
const cat = categoryFor(entry);
const updated = d.updatedDate ?? d.publishDate;
const minutes = readingTime(entry);
const products = d.products;
const top = products[0];
const related = await relatedArticles(entry);
const isDraft = d.status === 'draft';
const brandSuffix = ` | ${SITE.name}`;
const pageTitle = d.seoTitle ?? (d.title.length + brandSuffix.length <= 65 ? d.title + brandSuffix : d.title);
const ogImage = `/og/${cat.id}.png`;

const toc = [
  ...(products.length ? [{ id: 'top-picks', label: 'Our top picks at a glance' }] : []),
  ...products.map((p, i) => ({ id: productAnchor(p, i), label: `${i + 1}. ${shortName(p)}` })),
  ...(d.buyingGuide.length ? [{ id: 'buying-guide', label: 'Buying guide: what to look for' }] : []),
  ...(d.faq.length ? [{ id: 'faq', label: 'Frequently asked questions' }] : []),
];

// ── Structured data (JSON-LD) ───────────────────────────
const authorLd = { '@type': 'Person', name: SITE.author.name, url: absoluteUrl('/about/') };
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    image: [absoluteUrl(ogImage)],
    datePublished: d.publishDate.toISOString(),
    dateModified: updated.toISOString(),
    author: authorLd,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: absoluteUrl('/logo.png') } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': absoluteUrl(path) },
    articleSection: cat.name,
    ...(d.keyword ? { keywords: d.keyword } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: cat.name, item: absoluteUrl(categoryUrl(cat.id)) },
      { '@type': 'ListItem', position: 3, name: d.title, item: absoluteUrl(path) },
    ],
  },
];
if (products.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: d.title,
    numberOfItems: products.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `${absoluteUrl(path)}#${productAnchor(p, i)}`,
    })),
  });
}
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: plain(f.q), acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
  });
}
---
<Base
  title={pageTitle}
  description={d.description}
  path={path}
  ogImage={ogImage}
  ogType="article"
  noindex={isDraft}
  jsonLd={jsonLd}
  published={d.publishDate}
  modified={updated}
  progress
>
  <article class="wrap">
    <div class="read">
      {isDraft && (
        <p class="draft-banner" role="note">
          <strong>Draft.</strong> This guide is not published yet: it is hidden from the homepage and sitemap and marked <code>noindex</code>.
        </p>
      )}

      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: cat.name, href: categoryUrl(cat.id) }, { name: d.title }]} />

      <header class="art-head">
        <h1>{d.title}</h1>
        <p class="byline">
          <span class="avatar" aria-hidden="true"><Logo /></span>
          <span>
            By <a href="/about/" rel="author">{SITE.author.name}</a>
            <span class="sep" aria-hidden="true">·</span>
            Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            <span class="sep" aria-hidden="true">·</span>
            {minutes} min read
          </span>
        </p>
        <p class="disclosure" role="note">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 9v5M10 6.2v.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span>{SITE.disclosure} <a href="/affiliate-disclosure/">Read our affiliate disclosure</a>.</span>
        </p>
      </header>

      {products.length > 0 && (
        <section id="top-picks" class="quick" aria-labelledby="top-picks-h">
          <h2 id="top-picks-h" class="quick-title">Our top picks at a glance</h2>
          <table class="picks">
            <thead>
              <tr><th scope="col">Pick</th><th scope="col">Rating</th><th scope="col">Price</th><th scope="col"><span class="sr-only">Link</span></th></tr>
            </thead>
            <tbody>
              {products.map((p, i) => (
                <tr class:list={{ winner: i === 0 }}>
                  <th scope="row">
                    <span class="rank">{i + 1}</span>
                    <span class="pick-name">
                      {i === 0 && <span class="badge badge-top">Top pick</span>}
                      <a href={`#${productAnchor(p, i)}`}>{shortName(p)}</a>
                      {p.bestFor && <small>Best for: {p.bestFor}</small>}
                    </span>
                  </th>
                  <td data-label="Rating"><Stars value={p.ratingValue} compact /></td>
                  <td data-label="Price" class="price">{p.price ?? '—'}</td>
                  <td class="cta-cell"><AffiliateButton product={p} articleSlug={slug} position={i + 1} placement="quick_picks" label="View on Amazon" size="sm" /></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="checked">Prices and ratings checked {formatDate(updated)}. They change often — confirm on Amazon before buying.</p>
        </section>
      )}

      {toc.length > 2 && (
        <details class="toc" open>
          <summary>In this guide</summary>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
        </details>
      )}

      <div class="prose intro"><Content /></div>

      <aside class="method" aria-label="How we pick">
        <span class="method-ico" aria-hidden="true">✓</span>
        <p>{d.methodology ?? SITE.methodology} <a href="/how-we-pick/">Our full process</a>.</p>
      </aside>

      {products.map((p, i) => (
        <section class="product" id={productAnchor(p, i)} aria-labelledby={`${productAnchor(p, i)}-h`}>
          <div class="product-top">
            <span class="product-rank" aria-hidden="true">{i + 1}</span>
            <div>
              {i === 0 && <span class="badge badge-top">Top pick</span>}
              <h2 id={`${productAnchor(p, i)}-h`}><span class="sr-only">{i + 1}. </span>{p.name}</h2>
            </div>
          </div>
          {p.bestFor && <p class="best-for"><strong>Best for:</strong> {p.bestFor}</p>}
          <dl class="facts">
            {p.ratingValue !== undefined && <div><dt>Rating</dt><dd><Stars value={p.ratingValue} count={p.ratingCount} /></dd></div>}
            {p.price && <div><dt>Price</dt><dd class="price">{p.price}</dd></div>}
          </dl>
          {p.note && <div class="prose" set:html={md(p.note)} />}
          {(p.pros.length > 0 || p.cons.length > 0) && (
            <div class="pc">
              {p.pros.length > 0 && <div><h3>What we like</h3><ul class="pros">{p.pros.map((x) => <li set:html={mdInline(x)} />)}</ul></div>}
              {p.cons.length > 0 && <div><h3>Keep in mind</h3><ul class="cons">{p.cons.map((x) => <li set:html={mdInline(x)} />)}</ul></div>}
            </div>
          )}
          <AffiliateButton product={p} articleSlug={slug} position={i + 1} placement="product_card" block />
        </section>
      ))}

      {d.buyingGuide.length > 0 && (
        <section id="buying-guide" aria-labelledby="buying-guide-h">
          <h2 id="buying-guide-h">Buying guide: what to look for</h2>
          <div class="guide">
            {d.buyingGuide.map((g) => (
              <div class="guide-item">
                <h3>{g.heading}</h3>
                <div class="prose" set:html={md(g.text)} />
              </div>
            ))}
          </div>
        </section>
      )}

      {d.faq.length > 0 && (
        <section id="faq" aria-labelledby="faq-h">
          <h2 id="faq-h">Frequently asked questions</h2>
          <div class="faq">
            {d.faq.map((f, i) => (
              <details open={i === 0}>
                <summary><h3>{f.q}</h3></summary>
                <div class="prose" set:html={md(f.a)} />
              </details>
            ))}
          </div>
        </section>
      )}

      <aside class="author" aria-label="About the author">
        <span class="author-avatar" aria-hidden="true"><Logo /></span>
        <div>
          <p class="author-name"><a href="/about/" rel="author">{SITE.author.name}</a> <span>{SITE.author.role}</span></p>
          <p>{SITE.author.bio}</p>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h">Related articles</h2>
        <div class="card-grid cols-3">{related.map((a) => <PostCard article={a} />)}</div>
      </section>
    )}
  </article>

  {top && affiliateUrl(top) && (
    <div class="sticky-cta" id="sticky-cta" aria-hidden="true">
      <div>
        <span class="sticky-label">Our top pick</span>
        <span class="sticky-name">{shortName(top)}{top.price && <> · <b>{top.price}</b></>}</span>
      </div>
      <AffiliateButton product={top} articleSlug={slug} position={1} placement="sticky_mobile" label="Check Price" size="sm" />
    </div>
    <script is:inline>
      (function () {
        var bar = document.getElementById('sticky-cta');
        var picks = document.getElementById('top-picks');
        var footer = document.querySelector('.site-footer');
        if (!bar || !picks || !('IntersectionObserver' in window)) return;
        var pastPicks = false, atFooter = false;
        function sync() {
          var show = pastPicks && !atFooter;
          bar.classList.toggle('show', show);
          bar.setAttribute('aria-hidden', show ? 'false' : 'true');
          bar.querySelectorAll('a').forEach(function (a) { a.tabIndex = show ? 0 : -1; });
        }
        new IntersectionObserver(function (es) { es.forEach(function (e) { pastPicks = !e.isIntersecting && e.boundingClientRect.top < 0; }); sync(); }).observe(picks);
        if (footer) new IntersectionObserver(function (es) { es.forEach(function (e) { atFooter = e.isIntersecting; }); sync(); }).observe(footer);
        sync();
      })();
    </script>
  )}
</Base>

<style>
  .draft-banner { margin: 16px 0 0; padding: 12px 16px; background: #fff4d6; border: 1px solid #ecd28c; border-radius: var(--radius-sm); font-size: 0.95rem; }
  .art-head h1 { margin-top: 14px; }
  .byline { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.95rem; margin: 0 0 18px; }
  .byline a { font-weight: 700; color: var(--ink); text-decoration: none; }
  .byline a:hover { text-decoration: underline; }
  .avatar { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--sage-soft); display: grid; place-items: center; }
  .avatar :global(svg) { width: 22px; height: 22px; }
  .sep { margin: 0 6px; }
  .disclosure { display: flex; gap: 10px; align-items: flex-start; margin: 0 0 22px; padding: 12px 14px; background: var(--sand); border-radius: var(--radius-sm); font-size: 0.92rem; line-height: 1.5; color: var(--ink-2); }
  .disclosure svg { flex: none; width: 18px; height: 18px; margin-top: 2px; color: var(--sage-deep); }

  /* Quick picks: stacked cards on mobile, real table on wider screens */
  .quick { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px 14px 12px; margin: 0 0 22px; }
  .quick-title { margin: 0 0 12px; font-size: 1.3rem; }
  .picks { width: 100%; border-collapse: collapse; }
  .picks thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .picks tr { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'name name' 'rating price' 'cta cta'; gap: 8px 12px; padding: 14px 4px; border-top: 1px solid var(--line); }
  .picks tr:first-child { border-top: 0; }
  .picks tr.winner { background: linear-gradient(0deg, #fffaf2, #fff6ea); border-radius: 10px; padding: 14px 10px; border: 1px solid #f3d6b0; }
  .picks th[scope='row'] { grid-area: name; text-align: left; font-weight: 400; display: flex; gap: 12px; align-items: flex-start; }
  .picks td[data-label='Rating'] { grid-area: rating; }
  .picks td.price { grid-area: price; text-align: right; }
  .picks td.cta-cell { grid-area: cta; }
  .picks td.cta-cell :global(.btn) { width: 100%; }
  .rank { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--sage-deep); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 0.95rem; }
  .winner .rank { background: var(--cta); color: var(--cta-ink); }
  .pick-name { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
  .pick-name a { font-weight: 700; color: var(--ink); text-decoration: none; font-size: 1.05rem; line-height: 1.3; }
  .pick-name a:hover { text-decoration: underline; }
  .pick-name small { color: var(--muted); font-size: 0.88rem; line-height: 1.35; }
  .price { font-weight: 700; font-size: 1.05rem; color: var(--ink); }
  .checked { margin: 8px 4px 0; font-size: 0.82rem; color: var(--muted); }
  @media (min-width: 720px) {
    .quick { padding: 20px 20px 14px; }
    .picks thead { position: static; width: auto; height: auto; clip: auto; }
    .picks thead th { text-align: left; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding: 0 10px 8px; font-weight: 700; }
    .picks tr { display: table-row; }
    .picks th[scope='row'], .picks td { display: table-cell; vertical-align: middle; padding: 14px 10px; border-top: 1px solid var(--line); }
    .picks tbody tr:first-child > * { border-top: 0; }
    .picks tr.winner > * { background: #fff7ec; }
    .picks th[scope='row'] { display: table-cell; }
    .picks th[scope='row'] .rank { float: left; margin-right: 12px; }
    .picks td.price { text-align: left; }
    .picks td.cta-cell { text-align: right; width: 1%; white-space: nowrap; }
    .picks td.cta-cell :global(.btn) { width: auto; }
  }

  .toc { margin: 0 0 26px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .toc summary { cursor: pointer; padding: 14px 18px; font-weight: 700; list-style: none; display: flex; justify-content: space-between; align-items: center; min-height: 48px; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary::after { content: '+'; font-size: 1.3rem; color: var(--sage-deep); }
  .toc[open] summary::after { content: '–'; }
  .toc ol { margin: 0; padding: 0 18px 16px 40px; display: grid; gap: 4px; font-size: 1rem; }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(ul) { padding-left: 1.2em; margin: 0 0 1em; }
  .prose :global(li) { margin-bottom: 0.3em; }
  .intro :global(p:first-child) { font-size: 1.1rem; }

  .method { display: flex; gap: 12px; align-items: flex-start; margin: 8px 0 8px; padding: 14px 16px; border-left: 4px solid var(--sage); background: var(--sage-soft); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 0.97rem; }
  .method p { margin: 0; }
  .method-ico { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--sage-deep); color: #fff; display: grid; place-items: center; font-size: 0.8rem; font-weight: 700; margin-top: 2px; }

  .product { margin: 30px 0; padding: 20px 18px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); scroll-margin-top: 80px; }
  .product-top { display: flex; gap: 14px; align-items: flex-start; }
  .product-top h2 { margin: 4px 0 0; font-size: clamp(1.25rem, 4vw, 1.55rem); }
  .product-rank { flex: none; font-family: var(--font-head); font-size: 2.2rem; line-height: 1; color: var(--sage); min-width: 34px; }
  .best-for { margin: 14px 0 12px; padding: 10px 12px; background: var(--sand); border-radius: var(--radius-sm); font-size: 0.98rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 26px; margin: 0 0 12px; }
  .facts div { display: flex; flex-direction: column; }
  .facts dt { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .facts dd { margin: 0; }
  .pc { display: grid; gap: 4px 20px; margin-bottom: 8px; }
  .pc h3 { font-family: var(--font-body); font-size: 0.95rem; margin: 4px 0; }
  .pc ul { list-style: none; padding: 0; margin: 0 0 10px; font-size: 0.98rem; }
  .pc li { padding-left: 22px; position: relative; margin-bottom: 4px; }
  .pros li::before { content: '+'; position: absolute; left: 4px; color: var(--sage-deep); font-weight: 700; }
  .cons li::before { content: '–'; position: absolute; left: 4px; color: var(--terra); font-weight: 700; }
  @media (min-width: 640px) { .pc { grid-template-columns: 1fr 1fr; } .product { padding: 24px 26px; } }

  .guide { display: grid; gap: 14px; }
  .guide-item { padding: 16px 18px 4px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .guide-item h3 { margin: 0 0 6px; font-size: 1.12rem; }

  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; min-height: 48px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary h3 { margin: 0; font-size: 1.08rem; }
  .faq summary::after { content: '+'; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--sand); display: grid; place-items: center; color: var(--sage-deep); font-weight: 700; }
  .faq details[open] summary::after { content: '–'; }
  .faq .prose { padding-bottom: 6px; }

  .author { display: flex; gap: 16px; margin: 44px 0 0; padding: 20px; background: var(--sand); border-radius: var(--radius); }
  .author-avatar { flex: none; width: 56px; height: 56px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; }
  .author-avatar :global(svg) { width: 32px; height: 32px; }
  .author p { margin: 0 0 6px; font-size: 0.97rem; }
  .author-name a { font-weight: 700; color: var(--ink); }
  .author-name span { display: block; color: var(--muted); font-size: 0.88rem; }

  .related { margin-top: 56px; }
  .related h2 { margin-top: 0; }

  .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.97); border-top: 1px solid var(--line); box-shadow: 0 -6px 20px rgba(35, 43, 38, 0.08); transform: translateY(110%); transition: transform 0.2s ease; }
  .sticky-cta.show { transform: none; }
  .sticky-cta > div { min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
  .sticky-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .sticky-name { font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sticky-cta :global(.btn) { flex: none; }
  @media (min-width: 900px) { .sticky-cta { display: none; } }
  @media (prefers-reduced-motion: reduce) { .sticky-cta { transition: none; } }
</style>
