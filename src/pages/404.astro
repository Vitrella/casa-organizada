---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getLiveArticles } from '../lib/articles';
import { SITE } from '../site.config.mjs';
const latest = (await getLiveArticles()).slice(0, 3);
---
<Base title={`Page not found | ${SITE.name}`} description="The page you were looking for doesn't exist." path="/404/" noindex>
  <div class="wrap">
    <div class="read" style="padding-top:40px">
      <h1>We couldn't find that page</h1>
      <p>It may have moved when we reorganized the site. Try one of our latest guides or head back to the <a href="/">homepage</a>.</p>
    </div>
    <div class="card-grid cols-3" style="margin-top:28px">{latest.map((a) => <PostCard article={a} />)}</div>
  </div>
</Base>
