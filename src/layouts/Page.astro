---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { absoluteUrl } from '../lib/articles';
interface Props { title: string; heading: string; description: string; path: string; updated?: string }
const { title, heading, description, path, updated } = Astro.props;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: heading, item: absoluteUrl(path) },
  ],
}];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="read page">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: heading }]} />
      <h1>{heading}</h1>
      {updated && <p class="upd">Last updated {updated}</p>}
      <slot />
    </div>
  </div>
</Base>
<style>
  .upd { color: var(--muted); font-size: 0.95rem; }
  .page :global(h2) { font-size: 1.45rem; margin-top: 1.8em; }
  .page :global(ul) { padding-left: 1.2em; }
  .page :global(li) { margin-bottom: 0.4em; }
  .page :global(.box) { padding: 18px 20px; background: var(--sand); border-radius: var(--radius); margin: 1.4em 0; }
</style>
