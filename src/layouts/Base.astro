---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config.mjs';
import { absoluteUrl } from '../lib/articles';

interface Props {
  title: string; // full <title>
  description: string;
  path: string; // canonical path, e.g. "/best-kitchen-drawer-organizers/"
  ogImage?: string; // path under /og/
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  published?: Date;
  modified?: Date;
  progress?: boolean;
}

const { title, description, path, ogImage = '/og/home.png', ogType = 'website', noindex = false, jsonLd = [], published, modified, progress = false } = Astro.props;
const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage);
const ga = SITE.ga4Id;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    {SITE.pinterestSiteVerification && <meta name="p:domain_verify" content={SITE.pinterestSiteVerification} />}
    <meta name="theme-color" content="#fbf8f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preload" href="/fonts/fraunces-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Pinterest / Twitter -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}

    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Affiliate click tracking → GA4 event "affiliate_click" (no-op when GA4 is not configured) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-affiliate]');
        if (!a || typeof window.gtag !== 'function') return;
        window.gtag('event', 'affiliate_click', {
          asin: a.dataset.asin || '',
          article_slug: a.dataset.article || '',
          position: Number(a.dataset.position) || 0,
          placement: a.dataset.placement || '',
          link_url: a.href,
          transport_type: 'beacon'
        });
      });
    </script>
  </body>
</html>
