---
import { articleUrl, categoryFor, formatDate, type Article } from '../lib/articles';
import { illustrationFor } from '../lib/illustrations.mjs';
interface Props { article: Article; headingLevel?: 'h2' | 'h3' }
const { article, headingLevel = 'h3' } = Astro.props;
const cat = categoryFor(article);
const H = headingLevel;
const n = article.data.products.length;
---
<a class="post-card" href={articleUrl(article.id)}>
  <div class="art" set:html={illustrationFor(cat.id)} />
  <div class="body">
    <span class="chip" style="align-self:flex-start">{cat.name}</span>
    <H>{article.data.title}</H>
    <p>{article.data.description}</p>
    <div class="meta">
      {n > 0 && <span>{n} picks compared</span>}
      <span>Updated {formatDate(article.data.updatedDate ?? article.data.publishDate)}</span>
    </div>
  </div>
</a>
